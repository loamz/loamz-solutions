# Mail Concierge (read-only IMAP; use an app password, not your login password)
MAIL_IMAP_HOST=imap.gmail.com
MAIL_USER=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX
# addresses or @domains that always matter
MAIL_VIPS=
# addresses or @domains you never want buried
MAIL_KEEP=
MAIL_ABOUT=
# Alerts by email through Resend (no SMTP needed): a Resend API key, and the address to tell
# NOTIFY_RESEND_KEY=
# NOTIFY_EMAIL_TO=
# NOTIFY_FROM=Loamz <onboarding@resend.dev>
# only for `mail digest --send`
SMTP_HOST=smtp.gmail.com

# A model for mail the rules cannot rank, and for answering questions (any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini

# Where state lives
STATE_DIR=.state

# Paper Trader (Alpaca paper account; keys from the Alpaca dashboard)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# The paper endpoint is the default. If you set it, https://paper-api.alpaca.markets or the same with /v2 are both fine.
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# The desk: a strategy runs the whole paper account from the prices on Loamz Data (docs/trading.md, "The desk"). It is on
# when the market data is configured (docs/markets.md); then the per-symbol loop below stays off in `run`.
# TRADE_STRATEGY=momentum-trend      # or blend, trend; off turns the desk off
# TRADE_IDLE=SPY                     # where idle cash waits while the market trends up; none keeps it in cash
# DESK_EVENING_AT=18:15              # New York time: risk exits, and the weekly plan on Fridays

# The per-symbol loop: trading limits (defaults shown) and what to trade
TRADE_SYMBOLS=AAPL,MSFT
TRADE_MIN_CONFIDENCE=0.6
TRADE_RISK_PER_TRADE=0.01
TRADE_MAX_ORDER_NOTIONAL=5000
TRADE_MAX_POSITION_PCT=0.20
TRADE_MAX_DAILY_LOSS_PCT=0.02
TRADE_MAX_ORDERS_PER_DAY=10
TRADE_COOLDOWN_MIN=30
# The baseline's averages, and how often `run` checks for a trade while the market is open (seconds)
# MA_FAST=10
# MA_SLOW=30
# TRADE_EVERY=300
# Your own model, served over HTTP (see docs/trading.md). Empty: a moving-average baseline.
SIGNAL_URL=
SIGNAL_TOKEN=
# Live trading is refused unless BOTH of these are set. Paper first, for a long time.
# ALPACA_BASE_URL=https://api.alpaca.markets
# TRADE_ALLOW_LIVE=I_UNDERSTAND_THE_RISK

# Data Concierge: folders to index (comma separated) and, optionally, a Loamz deployment to include
DATA_FOLDERS=
# LOAMZ_ENDPOINT=https://data.example.com   (credentials: LOAMZ_TOKEN or LOAMZ_CLIENT_ID/SECRET/ISSUER)
# LOAMZ_USER_ID=

# Watchlist alerts (a rule list; checked every WATCH_EVERY seconds by `run`): levels, big moves, model signals
# WATCH_RULES=AAPL>200,AAPL<170,TSLA:move=3%,MSFT:signal

# Market data on Loamz Data (docs/markets.md): daily bars for the most liquid US stocks, in main.markets.
# A service account allowed to write main.markets (the Alpaca keys above are used for the data). These are the addresses a
# program on this machine uses; compose.yml sets the in-cell ones (CELL_DATA_URL, CELL_ISSUER).
# LOAMZ_ENDPOINT=http://localhost:8021
# LOAMZ_CLIENT_ID=loamz-markets
# LOAMZ_CLIENT_SECRET=
# LOAMZ_ISSUER=http://localhost:8081/realms/loamz
# MARKET_FEED=sip              # sip: every exchange (free for daily history); iex: one exchange
# MARKETS_UPDATE_AT=18:00      # New York time, after the close has settled
# LOAMZ_CELL_NETWORK=loamz-cell_default
