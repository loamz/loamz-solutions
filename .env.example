# Mail Concierge (read-only IMAP; use an app password, not your login password)
MAIL_IMAP_HOST=imap.gmail.com
MAIL_USER=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX
# addresses or @domains that always matter
MAIL_VIPS=
# addresses or @domains you never want buried
MAIL_KEEP=
MAIL_ABOUT=
# only for `mail digest --send`
SMTP_HOST=smtp.gmail.com

# A model for mail the rules cannot rank, and for answering questions (any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini

# Where state lives
STATE_DIR=.state

# Paper Trader (Alpaca paper account; keys from the Alpaca dashboard)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Trading limits (defaults shown) and what to trade
TRADE_SYMBOLS=AAPL,MSFT
TRADE_MIN_CONFIDENCE=0.6
TRADE_RISK_PER_TRADE=0.01
TRADE_MAX_ORDER_NOTIONAL=5000
TRADE_MAX_POSITION_PCT=0.20
TRADE_MAX_DAILY_LOSS_PCT=0.02
TRADE_MAX_ORDERS_PER_DAY=10
TRADE_COOLDOWN_MIN=30
# Your own model, served over HTTP (see docs/trading.md). Empty: a moving-average baseline.
SIGNAL_URL=
SIGNAL_TOKEN=
# Live trading is refused unless BOTH of these are set. Paper first, for a long time.
# ALPACA_BASE_URL=https://api.alpaca.markets
# TRADE_ALLOW_LIVE=I_UNDERSTAND_THE_RISK
